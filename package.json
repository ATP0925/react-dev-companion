{
  "name": "react-dev-companion",
  "version": "0.1.0",
  "description": "Embeddable React DevTools panel for real-time API monitoring and browser storage management",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "keywords": [
    "react",
    "devtools",
    "fetch-interceptor",
    "network-monitor",
    "nextjs",
    "open-source"
  ],
  "author": "Kickz1nn",
  "license": "MIT"
}
